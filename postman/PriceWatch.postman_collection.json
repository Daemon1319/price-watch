{
  "info": {
    "_postman_id": "pricewatch-uniqlo-001",
    "name": "PriceWatch",
    "description": "Local API smoke tests. Register/Login set accessToken from JSON and store the HttpOnly pw_refresh cookie automatically (Postman cookie jar). Refresh uses the cookie (empty body).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "trackedItemId", "value": "" }
  ],
  "item": [
    {
      "name": "1 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "2 Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var j = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', j.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user-{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "3 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var j = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', j.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "4 List Uniqlo variants",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/variants?url=https://www.uniqlo.com/ph/en/products/E471809-000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "products", "variants"],
          "query": [
            {
              "key": "url",
              "value": "https://www.uniqlo.com/ph/en/products/E471809-000"
            }
          ]
        }
      }
    },
    {
      "name": "5 Track Uniqlo product (color+size)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  var j = pm.response.json();",
              "  if (j.productId) { pm.collectionVariables.set('productId', j.productId); }",
              "  if (j.id) { pm.collectionVariables.set('trackedItemId', j.id); }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://www.uniqlo.com/ph/en/products/E471809-000\",\n  \"colorCode\": \"COL09\",\n  \"sizeCode\": \"SMA004\",\n  \"priceThreshold\": null,\n  \"notifyOnRestockOnly\": false\n}"
        },
        "url": "{{baseUrl}}/api/v1/tracked-items"
      }
    },
    {
      "name": "6 List tracked items",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/tracked-items"
      }
    },
    {
      "name": "7 Get product",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/products/{{productId}}"
      }
    },
    {
      "name": "8 Price history",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/products/{{productId}}/price-history"
      }
    },
    {
      "name": "9 Dashboard summary",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/dashboard/summary"
      }
    },
    {
      "name": "10 Delete tracked item",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tracked-items/{{trackedItemId}}",
        "description": "Deletes the tracked item. Uses trackedItemId saved from 4 Track Uniqlo product (the item id, not productId). Expect 204 No Content."
      }
    },
    {
      "name": "11 Refresh token (cookie)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var j = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', j.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/v1/auth/refresh",
        "description": "Uses pw_refresh HttpOnly cookie from login/register (Postman cookie jar). No body required."
      }
    }
  ]
}
